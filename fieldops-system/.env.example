# ==========================================
# Configurações do Ambiente (FieldOps v2.2)
# ==========================================

# Ambiente de execução (development, test, production)
NODE_ENV="development"

# Porta onde o servidor Fastify vai rodar
PORT=3333

# ==========================================
# Configurações de Banco de Dados (Prisma)
# ==========================================
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://admin:admin@localhost:5432/fieldops_postgres?schema=public"

# ==========================================
# Autenticação e Segurança
# ==========================================
# Chave secreta para assinatura dos tokens JWT (Não usar chave simples em PRD)
JWT_SECRET="sua_chave_secreta_super_segura_aqui_123"

# ==========================================
# Integrações (Webhooks)
# ==========================================
# Descomente e insira a URL caso queira testar o disparo de webhooks localmente
# WEBHOOK_TEST_URL="https://webhook.site/seu-uuid-aqui"